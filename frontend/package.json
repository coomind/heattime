{
  "name": "heattime-ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "test:e2e:demo": "playwright test --config playwright.demo.config.js",
    "test:e2e": "playwright test",
    "test:e2e:repeat": "npm run build && playwright test --repeat-each=3",
    "test:unit": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^7.0.0"
  }
}
